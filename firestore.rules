rules_version = '2';
// Respawn : seul le compte Google de Pierre peut lire et écrire, et seulement sous users/{son uid}.
// Tout le reste est refusé. À coller dans Firebase > Firestore Database > Règles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == 'wtakBbIPz1XpghxOWLiTaHbn2jH2';
    }
  }
}
